# Copia a .env (git-ignored) para cambiar los valores por defecto de docker compose. Sin secretos aquí: van a
# secrets/ (python scripts/generate_secrets.py).
DOW_TAG=1.4.5
DOW_PORT=8080
DOW_LOG_LEVEL=INFO
DOW_WORKER_MEM_LIMIT=6g
# Escaneos largos en tramos (G38): un proceso nuevo cada N documentos convertidos; 0 = nunca.
# DOW_SCAN_RECYCLE_DOCUMENTS=200
