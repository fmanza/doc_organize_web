# Copia a .env (git-ignored) para cambiar los valores por defecto de docker compose. Sin secretos aquí: van a
# secrets/ (python scripts/generate_secrets.py).
DOW_TAG=3.0.0
DOW_PORT=8080
DOW_LOG_LEVEL=INFO
DOW_WORKER_MEM_LIMIT=6g
# Límite de memoria del worker con GPU (perfil `gpu`).
# DOW_WORKER_GPU_MEM_LIMIT=8g
# Escaneos largos en tramos (G38): un proceso nuevo cada N documentos convertidos; 0 = nunca.
# DOW_SCAN_RECYCLE_DOCUMENTS=200
# Escaneo en carpetas de red (G11): tiempo máximo por documento en segundos (0 = sin límite), reintentos de E/S y
# reutilizar el hash de lo que no cambió de tamaño ni fecha.
# DOW_SCAN_DOCUMENT_TIMEOUT_SECONDS=0
# DOW_SCAN_IO_RETRIES=2
# DOW_SCAN_REUSE_HASHES=true
# Variantes de la imagen al construir (Fase 10): LibreOffice (.xls antiguos) y audio/vídeo (ffmpeg y Whisper).
# DOW_WITH_LIBREOFFICE=false
# DOW_WITH_AV=false
